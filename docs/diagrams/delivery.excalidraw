      "boundElements": null,
      "updated": 1791022006264,
      "link": null,
      "locked": false,
      "text": "The pipeline never talks to the cluster. Argo CD, running inside it, pulls from Git,\nso no cluster credential ever lives in GitHub.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "76b690065636469a9214",
      "originalText": "The pipeline never talks to the cluster. Argo CD, running inside it, pulls from Git,\nso no cluster credential ever lives in GitHub.",
      "lineHeight": 1.25
    },
