    {
      "id": "faea760f050f4ad88d09",
      "type": "text",
      "x": 62.39999999999998,
      "y": 946.75,
      "width": 865.2,
      "height": 87.5,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
