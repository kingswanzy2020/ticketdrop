      "roundness": null,
      "seed": 22944739,
      "version": 1,
      "versionNonce": 1387416484,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795755805584,
      "link": null,
      "locked": false,
      "text": "Route tables   (DNS hostnames and resolution on, which EKS needs)\npublic:   0.0.0.0/0  ->  internet gateway\nprivate, one per zone:   0.0.0.0/0  ->  the NAT in 1a, so 1b and 1c cross zones;   S3  ->  the endpoint\nUsable addresses:  251 in each public /24,  8,187 in each private /19\nFree for later:  10.40.99.0 - 10.40.255.255,  about 61% of the VPC",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "0c51e47425a34abb81be",
      "originalText": "Route tables   (DNS hostnames and resolution on, which EKS needs)\npublic:   0.0.0.0/0  ->  internet gateway\nprivate, one per zone:   0.0.0.0/0  ->  the NAT in 1a, so 1b and 1c cross zones;   S3  ->  the endpoint\nUsable addresses:  251 in each public /24,  8,187 in each private /19\nFree for later:  10.40.99.0 - 10.40.255.255,  about 61% of the VPC",
      "lineHeight": 1.25
    },
